{
  "name": "@hunyed15/claude-code-review",
  "version": "1.2.0",
  "description": "Independent read-only code review with the local Claude Code CLI, exposed as DSH tools plus a collab panel. Includes an internal ACP transport (auto-installed deps, no user ACP setup).",
  "license": "MIT",
  "author": "hunyed15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunyed15/dsh-claude-code-review.git"
  },
  "homepage": "https://github.com/hunyed15/dsh-claude-code-review#readme",
  "bugs": {
    "url": "https://github.com/hunyed15/dsh-claude-code-review/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "claude-code",
    "code-review",
    "acp"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./panel": "./panel.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "panel.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/Invoke-ClaudeReview.ps1",
    "scripts/acp-review.mjs",
    "scripts/install-git-hook.ps1",
    "scripts/git-hooks/pre-commit",
    "scripts/config.json",
    "scripts/review-schema.json",
    "scripts/reviewer-role.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.106.0",
    "@agentclientprotocol/sdk": "^2.6.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
