{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fix", "reject"],
      "description": "pass=可进入下一步；fix=有必先修的问题；reject=方向或实现有根本问题"
    },
    "summary": {
      "type": "string",
      "description": "一句话结论"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "point": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["point", "evidence"]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "important", "minor"]
          },
          "file": { "type": "string" },
          "line": { "type": "string" },
          "issue": { "type": "string" },
          "why": { "type": "string" },
          "fix": { "type": "string" }
        },
        "required": ["severity", "file", "line", "issue", "why", "fix"]
      }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assessment": { "type": "string" }
  },
  "required": ["verdict", "summary", "issues"]
}
